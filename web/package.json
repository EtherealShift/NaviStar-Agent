{
  "name": "navistar-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "desktop": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && npm run electron\"",
    "build": "vite build",
    "build:backend": "cd .. && uv run pyinstaller backend.spec --noconfirm --clean",
    "prebuild:desktop": "node scripts/prepare-desktop-build.cjs",
    "build:desktop": "npm run build:backend && npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --dir",
    "preview": "vite preview --host 0.0.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.navistar.desktop",
    "productName": "NaviStar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/NaviStarBackend.exe",
        "to": "backend/NaviStarBackend.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "wait-on": "^9.0.3"
  }
}
