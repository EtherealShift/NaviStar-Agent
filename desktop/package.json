{
  "name": "navistar-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NaviStar desktop client",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "electron .",
    "desktop": "npm run build && electron .",
    "backend": "cd .. && uv run uvicorn main:app --app-dir src --host 127.0.0.1 --port 8000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "clsx": "^2.1.1",
    "electron": "^39.2.7",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.1.17"
  }
}
